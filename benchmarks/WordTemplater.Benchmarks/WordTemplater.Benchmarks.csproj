  <ItemGroup>
    <ProjectReference Include="..\..\src\WordTemplater\WordTemplater.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\tests\WordTemplater.Tests\Infrastructure\TestTemplates.cs" Link="TestTemplates.cs" />
  </ItemGroup>

</Project>
